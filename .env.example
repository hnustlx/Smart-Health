# ====================================================
# Smart Health - Environment Configuration (Example)
# ====================================================

# MySQL root password
MYSQL_PASSWORD=your_mysql_password

# JWT signing secret (min 32 bytes for HMAC-SHA256)
JWT_SECRET=your_jwt_secret_at_least_32_chars_long

# DeepSeek API key (required for AI features)
DEEPSEEK_API_KEY=sk-your-api-key-here

# Chroma vector database URL
CHROMA_URL=http://localhost:8000
