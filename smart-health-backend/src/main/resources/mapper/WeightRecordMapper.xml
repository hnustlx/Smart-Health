<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smarthealth.mapper.WeightRecordMapper">

    <resultMap id="weightMap" type="com.smarthealth.entity.WeightRecord">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="weight" column="weight"/>
        <result property="recordDate" column="record_date"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="findByUserId" resultMap="weightMap">
        SELECT * FROM weight_record WHERE user_id = #{userId} ORDER BY record_date ASC
    </select>

    <select id="findById" resultMap="weightMap">
        SELECT * FROM weight_record WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO weight_record (user_id, weight, record_date)
        VALUES (#{userId}, #{weight}, #{recordDate})
    </insert>

    <delete id="deleteById">
        DELETE FROM weight_record WHERE id = #{id}
    </delete>
</mapper>
